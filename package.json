{
  "name": "@local/dsh-model-quota",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shows the selected model's remaining rate limit or balance under the composer.",
  "author": "BornCode (https://github.com/borncode-app)",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/borncode-app/dsh-model-quota.git" },
  "homepage": "https://github.com/borncode-app/dsh-model-quota#readme",
  "bugs": { "url": "https://github.com/borncode-app/dsh-model-quota/issues" },
  "keywords": ["dsh","deepseek-harness","dsh-plugin","quota","usage","rate-limit","credits","deepseek","minimax","anthropic","claude"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
